<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.TgAccountTaskMapper">

    <resultMap type="TgAccountTask" id="TgAccountTaskResult">
        <result property="id"          column="id"           />
        <result property="accountId"   column="account_id"   />
        <result property="phone"       column="phone"        />
        <result property="nodeId"      column="node_id"      />
        <result property="taskType"    column="task_type"    />
        <result property="param"       column="param"        />
        <result property="status"      column="status"       />
        <result property="errorReason" column="error_reason" />
        <result property="source"      column="source"       />
        <result property="sourceRef"   column="source_ref"   />
        <result property="createTime"  column="create_time"  />
        <result property="updateTime"  column="update_time"  />
    </resultMap>

    <!-- 列表不返回 param(含 2FA 密码) -->
    <select id="selectList" parameterType="TgAccountTask" resultMap="TgAccountTaskResult">
        select id, account_id, phone, node_id, task_type, status, error_reason, source, source_ref, create_time, update_time
        from tg_account_task
        <where>
            <if test="phone != null and phone != ''">
                AND phone like concat('%', #{phone}, '%')
            </if>
            <if test="taskType != null and taskType != ''">
                AND task_type = #{taskType}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="source != null and source != ''">
                AND source = #{source}
            </if>
            <if test="sourceRef != null and sourceRef != ''">
                AND source_ref = #{sourceRef}
            </if>
        </where>
        order by id desc
    </select>

    <insert id="batchInsert" parameterType="TgAccountTask">
        insert into tg_account_task (account_id, phone, node_id, task_type, param, status, source, source_ref, create_time) values
        <foreach item="t" collection="list" separator=",">
            (#{t.accountId}, #{t.phone}, #{t.nodeId}, #{t.taskType}, #{t.param}, 'pending', #{t.source}, #{t.sourceRef}, now())
        </foreach>
    </insert>

    <delete id="deleteByIds" parameterType="Integer">
        delete from tg_account_task where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteFinished">
        delete from tg_account_task where status != 'pending'
    </delete>

</mapper>
