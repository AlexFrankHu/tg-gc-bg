<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.TgContactAssignLogMapper">

    <resultMap type="TgContactAssignLog" id="TgContactAssignLogResult">
        <result property="id"                 column="id"                  />
        <result property="accountBatchNo"     column="account_batch_no"    />
        <result property="accountBatchTitle"  column="account_batch_title" />
        <result property="accountId"          column="account_id"          />
        <result property="accountPhone"       column="account_phone"       />
        <result property="contactBatchNo"     column="contact_batch_no"    />
        <result property="contactBatchTitle"  column="contact_batch_title" />
        <result property="contactPhone"       column="contact_phone"       />
        <result property="contactUsername"    column="contact_username"    />
        <result property="status"             column="status"              />
        <result property="remark"             column="remark"              />
        <result property="retryCount"         column="retry_count"         />
        <result property="createTime"         column="create_time"         />
        <result property="accountStatus"    column="account_status"     />
        <result property="nodeId"          column="node_id"          />
        <result property="addMethod"       column="add_method"       />
        <result property="errorReason"     column="error_reason"     />
    </resultMap>

    <select id="selectList" parameterType="TgContactAssignLog" resultMap="TgContactAssignLogResult">
        select l.*, a.status as account_status
        from tg_contact_assign_log l
        left join tg_telethon_account a on l.account_id = a.id
        <where>
            <if test="accountBatchNo != null and accountBatchNo != ''">AND l.account_batch_no = #{accountBatchNo}</if>
            <if test="contactBatchNo != null and contactBatchNo != ''">AND l.contact_batch_no = #{contactBatchNo}</if>
            <if test="accountPhone != null and accountPhone != ''">AND l.account_phone like concat('%', #{accountPhone}, '%')</if>
            <if test="status != null and status != ''">AND l.status = #{status}</if>
            <if test="params.beginCreateTime != null and params.beginCreateTime != ''">AND l.create_time &gt;= #{params.beginCreateTime}</if>
            <if test="params.endCreateTime != null and params.endCreateTime != ''">AND l.create_time &lt;= #{params.endCreateTime}</if>
        </where>
        order by l.id desc
    </select>

    <insert id="insert" parameterType="TgContactAssignLog">
        insert into tg_contact_assign_log (account_batch_no, account_batch_title, account_id, account_phone,
            contact_batch_no, contact_batch_title, contact_phone, contact_username, status, remark, retry_count, add_method, node_id, error_reason, create_time)
        values (#{accountBatchNo}, #{accountBatchTitle}, #{accountId}, #{accountPhone},
            #{contactBatchNo}, #{contactBatchTitle}, #{contactPhone}, #{contactUsername}, #{status}, #{remark}, #{retryCount}, #{addMethod}, #{nodeId}, #{errorReason}, now())
    </insert>

</mapper>
