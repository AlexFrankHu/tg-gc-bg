<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.TgAutoReplyLogMapper">

    <resultMap type="TgAutoReplyLog" id="TgAutoReplyLogResult">
        <result property="id"               column="id"               />
        <result property="accountPhone"     column="account_phone"    />
        <result property="accountNickname"  column="account_nickname" />
        <result property="friendUserId"     column="friend_user_id"   />
        <result property="friendNickname"   column="friend_nickname"  />
        <result property="friendPhone"      column="friend_phone"     />
        <result property="triggerType"      column="trigger_type"     />
        <result property="state"            column="state"            />
        <result property="requestParams"    column="request_params"   />
        <result property="chatContext"      column="chat_context"     />
        <result property="replyContent"     column="reply_content"    />
        <result property="sendResult"       column="send_result"      />
        <result property="errorReason"      column="error_reason"     />
        <result property="createTime"       column="create_time"      />
        <result property="nodeId"          column="node_id"          />
    </resultMap>

    <select id="selectList" parameterType="TgAutoReplyLog" resultMap="TgAutoReplyLogResult">
        select * from tg_auto_reply_log
        <where>
            <if test="accountPhone != null and accountPhone != ''">AND account_phone like concat('%', #{accountPhone}, '%')</if>
            <if test="friendNickname != null and friendNickname != ''">AND friend_nickname like concat('%', #{friendNickname}, '%')</if>
            <if test="friendPhone != null and friendPhone != ''">AND friend_phone like concat('%', #{friendPhone}, '%')</if>
            <if test="sendResult != null and sendResult != ''">AND send_result = #{sendResult}</if>
            <if test="triggerType != null and triggerType != ''">AND trigger_type = #{triggerType}</if>
        </where>
        order by id desc
    </select>

</mapper>
